"""Public contracts of the C++17 resident planning extension."""

from collections.abc import Callable, Iterable, Sequence
from typing import Any

backend: str

def completion_frontier_prediction(
    points: Sequence[Sequence[Sequence[float]]],
    *,
    export_frontiers: bool = True,
) -> dict[str, Any]: ...
def completion_frontier_prediction_buffer(
    points: Any, *, export_frontiers: bool = True
) -> dict[str, Any]: ...

class ActionBudgetExceeded(ValueError): ...

class PlanNodeHandle:
    handle_id: int
    node_id: int
    children: list[int]
    height: int
    operator_id: int | None
    field_ids: list[int]
    relation_keys: set[str]
    pending_join: int | None
    pair_field_ids: list[list[int]]

class StateHandle:
    handle_id: int
    done: set[int]
    depth: int
    action_json: str
    roots: list[int]
    remaining: list[int]
    history: list[str]
    node_count: int
    def node_at(self, index: int) -> PlanNodeHandle: ...
    def nodes(self) -> list[PlanNodeHandle]: ...
    def structure_key(self) -> str: ...

class StateProblem:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def update_resources(
        self, models: dict[str, Any], constraints: dict[str, Any]
    ) -> None: ...
    def initial(self) -> StateHandle: ...
    def complete(self, state: StateHandle) -> bool: ...
    def input_choices(self, state: StateHandle, oid: int) -> list[list[int]]: ...
    def state_key(self, state: StateHandle) -> str: ...
    def logical_structure(self, state: StateHandle) -> dict[str, Any]: ...
    def actions(
        self,
        state: StateHandle,
        prioritize_relational: bool = False,
        fixed_layout: bool = False,
        highest_priorities: dict[int, Sequence[float]] | None = None,
        fixed_model_id: str | None = None,
    ) -> list[dict[str, Any]]: ...
    def transition(self, state: StateHandle, action: dict[str, Any]) -> StateHandle: ...
    def feasible_action(self, state: StateHandle, action: dict[str, Any]) -> bool: ...

class NativeObservation:
    def __init__(
        self,
        token: Any,
        references: Any,
        rows: Any,
        statistics: Any,
        complete: bool,
        boundary: Any,
    ) -> None: ...
    token: Any
    references: Any
    rows: Any
    statistics: Any
    complete: bool
    boundary: Any

class ObservationWeights:
    def __init__(self, strata: dict[Any, Any], row_strata: dict[Any, Any]) -> None: ...
    def weight(self, row: Any) -> float: ...
    def mass(self, rows: Iterable[Any]) -> float: ...
    def effective(self, rows: Iterable[Any]) -> float: ...

def observation_effective(*args: Any) -> Any: ...
def observation_interval(*args: Any) -> Any: ...
def observation_field_rates(*args: Any) -> Any: ...
def observation_summarize(cells: list, weights: ObservationSummaryWeights) -> tuple: ...
def observation_summarize_values(
    rows: Sequence,
    weights: ObservationSummaryWeights,
    serialize: Callable,
    published_dictionary: Any = None,
) -> tuple: ...

class SelfTerms:
    def __init__(self, counts: Sequence[int], tau: float) -> None: ...
    def evaluate(self, alpha: float) -> float: ...

class CrossTerms:
    def __init__(self, pairs: Sequence[tuple[int, int]], tau: float) -> None: ...
    def evaluate(self, source: float, target: float) -> float: ...

class FeatureBuffer: ...

class NativeSQLBackend:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def load(self, relation: str, sql: str) -> list[dict[str, Any]]: ...
    def execute(
        self, op: dict[str, Any], inputs: Sequence[Any], action: Any = None
    ) -> Any: ...
    def prepare_inputs(
        self, op: dict[str, Any], inputs: Sequence[Any]
    ) -> list[Any]: ...
    def join_pairs(
        self, op: dict[str, Any], pairs: Sequence[Any], action: Any
    ) -> Any: ...
    def estimate_relation(
        self, op: dict[str, Any], inputs: Sequence[Any]
    ) -> dict[str, Any]: ...
    events: list[dict[str, Any]]
    observations: list[dict[str, Any]]
    def selection_progress(self) -> dict[str, Any]: ...
    def drain_events(self) -> list[dict[str, Any]]: ...
    def drain_observations(self) -> list[dict[str, Any]]: ...
    def diagnostics(self) -> dict[str, Any]: ...
    def timings(self) -> dict[str, Any]: ...
    def close(self) -> None: ...

class SearchEnvironment: ...

class NativeSampler(SearchEnvironment):
    def __init__(self, config: dict[str, Any], backend: NativeSQLBackend) -> None: ...
    def calibrate_time(self, state: StateHandle) -> dict[str, Any]: ...
    def observe(self, state: StateHandle) -> None: ...
    def refresh(self, states: Sequence[StateHandle]) -> None: ...
    def accuracy(self, state: StateHandle) -> None: ...
    def accuracy_batch(self, states: Sequence[StateHandle]) -> None: ...
    def statistics(self, state: StateHandle) -> dict[str, Any]: ...
    def full_statistics(self, state: StateHandle) -> dict[str, Any]: ...
    def samples(self, state: StateHandle) -> dict[str, Any]: ...
    def cache(self, state: StateHandle) -> dict[str, Any]: ...
    def profile(self) -> dict[str, Any]: ...
    def history(self) -> list[dict[str, Any]]: ...
    def calls(self) -> dict[str, Any]: ...
    def timings(self) -> dict[str, Any]: ...
    def telemetry(self) -> dict[str, Any]: ...
    def config(self) -> dict[str, Any]: ...

class NativeSearchEngine:
    expansions: int
    def __init__(self, problem: StateProblem, sampler: SearchEnvironment) -> None: ...
    def search(
        self,
        config: dict[str, Any],
        predict: Callable[[dict[str, Any]], Any],
        random_state: Sequence[int],
        original: Sequence[StateHandle] = (),
    ) -> dict[str, Any]: ...

class ProfileEnvironment(SearchEnvironment):
    def __init__(self, config: dict[str, Any]) -> None: ...
    def observe(self, state: StateHandle) -> None: ...
    def refresh(self, states: Sequence[StateHandle]) -> None: ...
    def accuracy(self, state: StateHandle) -> None: ...
    def apply_runtime(
        self,
        state: StateHandle,
        operator_id: int,
        entry: dict[str, Any],
        observation: dict[str, Any] | None = None,
    ) -> None: ...
    def statistics(self, state: StateHandle) -> dict[str, Any]: ...
    def full_statistics(self, state: StateHandle) -> dict[str, Any]: ...
    def cache(self, state: StateHandle) -> dict[str, Any]: ...
    def profile(self) -> dict[str, Any]: ...
    def history(self) -> list[dict[str, Any]]: ...
    def calls(self) -> dict[str, Any]: ...
    def timings(self) -> dict[str, Any]: ...
    def config(self) -> dict[str, Any]: ...

def search_runtime(
    problem: StateProblem,
    environment: ProfileEnvironment,
    config: dict[str, Any],
    predict: Callable[[dict[str, Any]], Any],
) -> list[dict[str, Any]]: ...
def select_completions(
    scores: Sequence[Sequence[float]],
    times: Sequence[float | None],
    accuracies: Sequence[float | None],
    minimum: float | None,
) -> dict[str, Any]: ...

def prune_structure_groups(
    problem: StateProblem,
    states: Sequence[StateHandle],
    prediction: dict[str, Any],
    maximum_groups: int = 15,
    per_group: int = 6,
) -> dict[str, Any]: ...

class FeatureBuffers:
    def __init__(
        self, features: Iterable[dict[str, Any]], width: int, history_width: int
    ) -> None: ...
    numeric: FeatureBuffer
    history: FeatureBuffer
    offsets: list[int]

class ObservationSummaryWeights:
    def __init__(self, weights: Sequence[float], total: float) -> None: ...

def extension_path() -> str: ...
def statistics_path() -> str: ...

class NativeFeatureBatch:
    numeric: Any
    history: Any
    templates: list[dict[str, Any]]
    work: list[list[dict[str, Any]]]
    node_indices: Any
    source_indices: Any
    relations: Any
    reuse: Any
    reuse_present: Any
    edge_mask: Any
    node_mask: Any
    root_mask: Any
    work_indices: Any
    sizes: Any
    chunk_offsets: list[int]
    descriptions_by_chunk: list[list[Any]]
    chunk_shapes: list[tuple[int, int]]
    chunk_size: int
    has_work: bool

class NativeFeatureContext:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def pack(
        self, states: Sequence[StateHandle], environment: ProfileEnvironment
    ) -> NativeFeatureBatch: ...
